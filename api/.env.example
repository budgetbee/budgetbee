APP_NAME=BudgetBee
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=v0.17

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Auto-categorisation: the words your bank wraps around the merchant name
# and the aliases that group its variants. They belong to the installation,
# not to the project, so the code ships no dictionary at all.
# CATEGORIZATION_GENERIC_TOKENS="CARD,PURCHASE,DIRECT,DEBIT,REF"
# CATEGORIZATION_ALIASES="LONGFORM SHOP NAME=SHOP,SHOP CARD=SHOP"
